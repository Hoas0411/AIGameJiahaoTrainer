theme_override_font_sizes/font_size = 20
text = "Gridshot 三球定位\n三球同时存在，命中立即补位。\n60 秒练快速转移与点击时机。"

[node name="Course1" type="Button" parent="Panel"]
offset_left = 446.0
offset_top = 145.0
offset_right = 828.0
offset_bottom = 251.0
theme_override_font_sizes/font_size = 20
text = "平滑跟枪\n持续向横移机器人扫射。\n分别观察准心覆盖和子弹命中。"

[node name="Course2" type="Button" parent="Panel"]
offset_left = 846.0
offset_top = 145.0
offset_right = 1228.0
offset_bottom = 251.0
theme_override_font_sizes/font_size = 20
text = "变向跟枪\n有界随机横移，有限加速度。\n识别反向后重新捕获目标。"

[node name="Course3" type="Button" parent="Panel"]
offset_left = 46.0
offset_top = 265.0
offset_right = 428.0
offset_bottom = 371.0
theme_override_font_sizes/font_size = 20
text = "架中门缝\nAWM 架住窄缝，等待横穿。\nF9 调节缝宽、速度和方向。"

[node name="Course4" type="Button" parent="Panel"]
offset_left = 446.0
offset_top = 265.0
offset_right = 828.0
offset_bottom = 371.0
theme_override_font_sizes/font_size = 20
text = "Apex 六靶转移\n六个人形靶，中间向外再返回。\n命中优先目标后转移准心。"

[node name="Course5" type="Button" parent="Panel"]
offset_left = 846.0
offset_top = 265.0
offset_right = 1228.0
offset_bottom = 371.0
theme_override_font_sizes/font_size = 20
text = "Valorant 横移修正\n瞄过 → 横移修正 → 停稳爆头。\n检查鼠标与脚步是否配合。"

[node name="Course6" type="Button" parent="Panel"]
offset_left = 46.0
offset_top = 385.0
offset_right = 428.0
offset_bottom = 491.0
theme_override_font_sizes/font_size = 20
text = "CS2 预瞄清角\n穿过三道交错挡墙，逐角清除。\n减少同时暴露的危险角度。"

[node name="Course7" type="Button" parent="Panel"]
offset_left = 446.0
offset_top = 385.0
offset_right = 828.0
offset_bottom = 491.0
theme_override_font_sizes/font_size = 20
text = "Apex 横移六靶爆头\n交替横移时，转移到六靶头部。\n身体或错误脚步命中不会推进。"

[node name="Course8" type="Button" parent="Panel"]
offset_left = 846.0
offset_top = 385.0
offset_right = 1228.0
offset_bottom = 491.0
theme_override_font_sizes/font_size = 20
text = "Valorant 双靶微调\n相邻两个头部交替射击。\n练小角度修正与准确制动。"

[node name="Course9" type="Button" parent="Panel"]
offset_left = 46.0
offset_top = 505.0
offset_right = 428.0
offset_bottom = 611.0
theme_override_font_sizes/font_size = 20
text = "Valorant 瞄不足修正\n瞄不足 → 同向横移 → 停稳爆头。\n与瞄过版成对练习误差修正。"
